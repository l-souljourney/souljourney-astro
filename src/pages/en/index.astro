---
// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 页面 Info
import SITE_CONFIG from "@/config";
const { Title, Description } = SITE_CONFIG;
// 公共 Layout
import Layout from "@/layouts/Layout/Layout.astro";
---

<Layout description={Description} hideAside>
	<section class="relative flex flex-col justify-center min-h-[52vh] py-[5.88rem] px-[0.88rem]">
		<h1 class="text-[1.5rem] md:text-[2.5rem] font-bold leading-[1.25] tracking-tight text-foreground">
			{Title}
		</h1>
		<p class="mt-[1.38rem] max-w-[44rem] text-base md:text-[1.06rem] leading-[1.9] text-muted-foreground">
			{Description}
		</p>
		<section class="mt-[2.38rem] flex flex-wrap items-center gap-[0.88rem]">
			<a href="/en/blog" class="inline-flex items-center h-[2.5rem] px-[1.38rem] rounded-2xl bg-primary text-primary-foreground text-[0.98rem] font-semibold transition-colors hover:bg-primary/88">
				{t('home.startReading')}
			</a>
			<a href="/en/about" class="inline-flex items-center h-[2.5rem] px-[1.38rem] rounded-2xl border border-border text-foreground text-[0.98rem] font-semibold transition-colors hover:bg-accent hover:text-accent-foreground">
				{t('nav.about')}
			</a>
		</section>
	</section>
</Layout>
