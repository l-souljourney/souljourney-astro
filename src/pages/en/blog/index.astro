---
import { getCollection } from "astro:content";
import moveTopToFirst from "@/utils/moveTopToFirst";
import { getSortedPublishedBlogEntriesByLang } from "@/utils/publishedBlog";

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getCollection("blog");
const enPosts = getSortedPublishedBlogEntriesByLang(posts, "en");
// 置顶文章功能
moveTopToFirst(enPosts);

// 页面 Info
import SITE_CONFIG from "@/config";
const { Description } = SITE_CONFIG;
// 博客列表组件
import ArticleCard from "@/components/ArticleCard/ArticleCard.astro";
// 公共 Layout
import Layout from "@/layouts/Layout/Layout.astro";
---

<Layout title={t('nav.posts')} description={Description} activeNav="blog">
	<section class="relative w-full h-max pb-[6.88rem]">
		<section class="relative grid w-full overflow-hidden gap-[1.288rem] grid-cols-1 min-[556px]:grid-cols-2 min-[1150px]:grid-cols-3">
			{enPosts.map((post, index) => <ArticleCard post={post} index={index} />)}
		</section>
	</section>
</Layout>
