---
// 搜索 UI 用 Pagefind 官方 Component UI：弹窗、输入框、结果与键盘提示都由组件自己组装，
// 这里只负责声明组件、把 Header 的入口按钮接上，以及把站点主题映射到组件变量。
import { join } from "node:path/posix";

const bundlePath = join(import.meta.env.BASE_URL, "pagefind/");
---

<pagefind-config bundle-path={bundlePath}></pagefind-config>
<pagefind-modal reset-on-close></pagefind-modal>

<script>
	import "@pagefind/component-ui/css";
	import "@pagefind/component-ui";

	type SearchWindow = Window & { __vhSearchThemeBound?: boolean };

	// Header 的搜索入口打开官方弹窗；弹窗自身的开关、ESC、点背景关闭、焦点与滚动锁定
	// 都由组件负责，这里不再自研。
	const bindSearchEntry = () => {
		const searchBtn = document.querySelector(".search-btn");
		const searchModal = document.querySelector("pagefind-modal") as (HTMLElement & { open?: () => void }) | null;
		if (!searchBtn || !searchModal || typeof searchModal.open !== "function") return;
		if (searchBtn.getAttribute("data-search-bound") === "true") return;
		searchBtn.setAttribute("data-search-bound", "true");
		searchBtn.addEventListener("click", () => searchModal.open?.());
	};

	// 组件用 [data-pf-theme="dark"] 切暗色，站点用 html.dark；把两者同步起来，
	// 观察 class 变化即可覆盖首屏与手动切换两条路径。
	const syncSearchTheme = () => {
		document.documentElement.dataset.pfTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
	};

	const start = () => {
		bindSearchEntry();
		syncSearchTheme();
	};

	start();
	document.addEventListener("astro:page-load", start);

	const win = window as SearchWindow;
	if (!win.__vhSearchThemeBound) {
		new MutationObserver(syncSearchTheme).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});
		win.__vhSearchThemeBound = true;
	}
</script>

<style is:global>
	/* 变量按“离元素更近者胜”的继承规则挂在 body 上，用站点令牌驱动，
	   这样亮/暗两套配色跟着 html.dark 自动切换，不需要打特异性官司。 */
	body {
		--pf-font: inherit;
		--pf-text: hsl(var(--foreground));
		--pf-text-secondary: hsl(var(--muted-foreground));
		--pf-text-muted: hsl(var(--muted-foreground));
		--pf-background: hsl(var(--card));
		--pf-border: hsl(var(--border));
		--pf-border-focus: hsl(var(--primary) / 0.5);
		--pf-hover: hsl(var(--accent));
		--pf-mark: hsl(var(--foreground));
		--pf-outline-focus: hsl(var(--primary));
		--pf-modal-backdrop: rgb(0 0 0 / 0.26);
		--pf-modal-max-width: 888px;
		--pf-modal-max-height: 88vh;
		--pf-modal-top: 3.75rem;
		--pf-shadow-lg: 0 16px 48px rgb(0 0 0 / 0.2);
	}

	/* 弹窗与 Header 的间距对齐旧版的 pt-[3.75rem]，小屏留出边距。 */
	dialog.pf-modal {
		margin-inline: auto;
		width: calc(100% - 2rem);
	}
</style>
